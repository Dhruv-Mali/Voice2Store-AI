APP_NAME=Voice2Store AI
APP_ENV=production
BACKEND_PORT=8000
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com","https://www.app.example.com"]
ALLOWED_HOSTS=["app.example.com","www.app.example.com","localhost","127.0.0.1"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/voice2store
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=INR
